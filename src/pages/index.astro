            src="/images/moments/moment-3.jpg" 
            alt="Auditorium caucus discussion" 
            class="w-full h-64 sm:h-72 md:h-80 object-cover object-center group-hover:scale-105 transition-transform duration-500" 
            loading="lazy" 
          />
        </div>

        <!-- Row 2: Image 4 (Podium Address) -->
        <div class="moment-item md:col-span-5 overflow-hidden rounded-xl bg-slate-200 border border-slate-200/80 shadow-xs group">
          <img 
            src="/images/moments/moment-4.jpg" 
            alt="Speaking at the podium" 
            class="w-full h-64 sm:h-72 md:h-80 object-cover object-center group-hover:scale-105 transition-transform duration-500" 
            loading="lazy" 
          />
        </div>

        <!-- Row 2: Images 5 & 6 Stacked Column -->
