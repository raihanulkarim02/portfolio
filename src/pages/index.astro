    <!-- Moments in Action: Asymmetrical Collage with Scroll-Reveal -->
    <section id="moments" class="space-y-6">
      <div>
        <h2 class="text-xl font-black section-title">Moments in Action</h2>
        <p class="text-xs text-slate-500 mt-0.5">Summits, stage coordination, caucus sessions, and team operations on the ground</p>
      </div>

      <!-- Asymmetrical 12-Column Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-3.5 sm:gap-4 items-stretch">
        
        <!-- Row 1: Image 1 (Panel Discussion) -->
        <div class="moment-item md:col-span-5 overflow-hidden rounded-xl bg-slate-200 border border-slate-200/80 shadow-xs group">
          <img 
            src="/images/moments/moment-1.jpg" 
            alt="Panel discussion session" 
            class="w-full h-56 sm:h-64 md:h-72 object-cover object-center group-hover:scale-105 transition-transform duration-500" 
            loading="lazy" 
          />
        </div>

        <!-- Row 1: Image 2 (TEDx CUET Stage Wide) -->
        <div class="moment-item md:col-span-7 overflow-hidden rounded-xl bg-slate-200 border border-slate-200/80 shadow-xs group">
          <img 
            src="/images/moments/moment-2.jpg" 
            alt="TEDx CUET stage" 
            class="w-full h-56 sm:h-64 md:h-72 object-cover object-center group-hover:scale-105 transition-transform duration-500" 
            loading="lazy" 
          />
        </div>

        <!-- Row 2: Image 3 (Auditorium Huddle) -->
        <div class="moment-item md:col-span-4 overflow-hidden rounded-xl bg-slate-200 border border-slate-200/80 shadow-xs group">
