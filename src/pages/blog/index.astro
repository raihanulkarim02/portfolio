---
// src/pages/blog/index.astro
import '../../styles/global.css';

// Fetch all markdown posts inside src/content/blog/
const posts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));

// Sort posts by publication date (newest first)
posts.sort((a: any, b: any) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog & Insights | Muhammad Raihanul Karim</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Lato', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased selection:bg-amber-800 selection:text-white">

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-5 h-16 flex items-center justify-between">
      <a href="/" class="font-black text-base tracking-tight text-slate-900">RAIHANUL KARIM</a>
      <nav class="flex items-center gap-5 text-sm font-semibold text-slate-600">
        <a href="/" class="hover:text-amber-800 transition">Portfolio</a>
        <a href="/blog" class="text-amber-800 font-bold transition">Blog</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-3xl mx-auto px-5 py-16">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-3">Writing & Field Notes</h1>
      <p class="text-base text-slate-600 leading-relaxed">
        Perspectives on materials engineering, operations management, case studies, and personal projects.
      </p>
    </div>

    <!-- Posts List -->
    <div class="space-y-6">
      {posts.map((post: any) => {
        // Derive post URL slug from filename
        const slug = post.file.split('/').pop().replace('.md', '');
        return (
          <article class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-amber-700/50 transition">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="text-xs font-semibold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full">
                {post.frontmatter.pubDate}
              </span>
              {post.frontmatter.tags && post.frontmatter.tags.map((tag: string) => (
                <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                  #{tag}
                </span>
              ))}
            </div>
            <h2 class="text-xl font-bold text-slate-900 hover:text-amber-800 transition mb-2">
              <a href={`/blog/${slug}`}>{post.frontmatter.title}</a>
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed mb-4">
              {post.frontmatter.description}
            </p>
            <a href={`/blog/${slug}`} class="text-xs font-bold text-amber-800 hover:text-amber-900 inline-flex items-center gap-1">
              Read Article &rarr;
            </a>
          </article>
        );
      })}
    </div>
  </main>

  <footer class="border-t border-slate-200 py-8 bg-white text-center text-xs text-slate-500">
    <p>© 2026 Muhammad Raihanul Karim</p>
  </footer>

</body>
</html>