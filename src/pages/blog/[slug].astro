---
// src/pages/blog/[slug].astro
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = Object.entries(import.meta.glob('../../content/blog/*.md', { eager: true }));
  return posts.map(([path, post]: [string, any]) => {
    const slug = path.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{post.frontmatter.title} | Raihanul Karim</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Lato', sans-serif; }
    .prose h3 { font-size: 1.35rem; font-weight: 800; color: #0f172a; margin-top: 1.75rem; margin-bottom: 0.75rem; }
    .prose p { margin-bottom: 1.25rem; line-height: 1.75; color: #334155; }
    .prose ul { list-style-type: disc; margin-left: 1.25rem; margin-bottom: 1.25rem; color: #334155; }
    .prose li { margin-bottom: 0.5rem; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased selection:bg-amber-800 selection:text-white">

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-5 h-16 flex items-center justify-between">
      <a href="/" class="font-black text-base tracking-tight text-slate-900">RAIHANUL KARIM</a>
      <nav class="flex items-center gap-5 text-sm font-semibold text-slate-600">
        <a href="/" class="hover:text-amber-800 transition">Portfolio</a>
        <a href="/blog" class="text-amber-800 font-bold transition">Blog</a>
      </nav>
    </div>
  </header>

  <!-- Post Body -->
  <article class="max-w-3xl mx-auto px-5 py-16">
    <a href="/blog" class="text-xs font-bold text-amber-800 hover:text-amber-900 inline-flex items-center gap-1 mb-6">
      &larr; Back to all articles
    </a>
    
    <header class="mb-10 pb-6 border-b border-slate-200">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-4">
        {post.frontmatter.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
        <span>Published on {post.frontmatter.pubDate}</span>
        <span>•</span>
        <span>Muhammad Raihanul Karim</span>
      </div>
    </header>

    <div class="prose max-w-none text-base">
      <Content />
    </div>
  </article>

  <footer class="border-t border-slate-200 py-8 bg-white text-center text-xs text-slate-500">
    <p>© 2026 Muhammad Raihanul Karim</p>
  </footer>

</body>
</html>